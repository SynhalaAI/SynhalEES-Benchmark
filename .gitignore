__pycache__/
*.pyc

# Benchmark run artifacts (raw, per-machine; never published)
runs/
submission.csv

# ...but submissions/ IS the committed source of truth for the site data,
# so per-model scorecards there are tracked even when named submission.csv.
!submissions/*.csv

# Kaggle Benchmarks artifacts (kaggle b t download -o kaggle-results)
# Raw run output stays local (tens of MB per run: audio ~590MB); publish only
# via submissions/<model-slug>.csv. The ~1KB *.slim.csv scorecard exports ARE
# tracked as lightweight records (the slim option makes this safe).
kaggle-results/*
!kaggle-results/*.slim.csv

# Packaging artifacts (pip install -e .)
*.egg-info/
build/
dist/

# Editor/OS noise
*~lock~
