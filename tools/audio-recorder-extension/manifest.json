{
  "manifest_version": 3,
  "name": "Simple Audio Recorder",
  "version": "1.3.0",
  "description": "Record audio from your microphone and download it as a file.",
  "permissions": ["tabCapture", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Audio Recorder"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
